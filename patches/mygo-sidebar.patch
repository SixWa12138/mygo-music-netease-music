diff --git a/internal/app/sidebar_test.go b/internal/app/sidebar_test.go
index 17540fa..f3a2863 100644
--- a/internal/app/sidebar_test.go
+++ b/internal/app/sidebar_test.go
@@ -78,3 +78,48 @@ func TestNewPlaylistInCollapsedSidebar(t *testing.T) {
 		t.Error("the plus also toggled a playlist section")
 	}
 }
+
+// Positioned playlist groups still collapse and navigate, and a following podcast tab remains reachable.
+func TestPositionedSidebarGroups(t *testing.T) {
+	a := editTestApp()
+	f := fake(a)
+	f.caps["shows"] = true
+	a.library.caps = probeCaps(f)
+	f.info.Navigation = []music.NavItem{
+		{Builtin: "home"},
+		{Builtin: "separator"},
+		{Builtin: "liked"},
+		{Builtin: "myPlaylists", Title: "Created"},
+		{Builtin: "savedPlaylists", Title: "Saved"},
+		{Builtin: "shows", Title: "My Podcasts"},
+	}
+	a.playlists["20"] = &music.Playlist{ID: "20", Name: "飙升榜"}
+	tt := ui.NewTester(a.view, 1200, 1000)
+	tt.Frame()
+	if err := tt.Click("Saved"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Frame()
+	if _, ok := tt.Find("飙升榜"); ok {
+		t.Fatal("the collapsed group still exposes its playlist")
+	}
+	if _, ok := tt.Find("Saved Playlists"); ok {
+		t.Fatal("the automatic group duplicated the positioned group")
+	}
+	if err := tt.Click("Saved"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Frame()
+	if err := tt.Click("飙升榜"); err != nil {
+		t.Fatal(err)
+	}
+	if a.route.page != pagePlaylist || a.route.id != "20" {
+		t.Fatalf("opened %+v", a.route)
+	}
+	if err := tt.Click("My Podcasts"); err != nil {
+		t.Fatal(err)
+	}
+	if a.route.page != pageShows {
+		t.Fatalf("opened %+v", a.route)
+	}
+}
