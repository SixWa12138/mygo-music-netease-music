diff --git a/internal/app/navigation_frame_test.go b/internal/app/navigation_frame_test.go
new file mode 100644
index 0000000..4cbecbb
--- /dev/null
+++ b/internal/app/navigation_frame_test.go
@@ -0,0 +1,32 @@
+package app
+
+import (
+	"encoding/json"
+	"os"
+	"testing"
+
+	"github.com/egoist/mygo/ui"
+	"mygo-music/internal/music"
+)
+
+// With a plugin manifest and MM_FRAMES set, saves its complete sidebar for visual review.
+func TestPluginSidebarFrame(t *testing.T) {
+	dir := framesDir(t)
+	manifest, err := os.ReadFile(os.Getenv("MM_NAV_MANIFEST"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var info music.Info
+	if err := json.Unmarshal(manifest, &info); err != nil {
+		t.Fatal(err)
+	}
+	a := editTestApp()
+	f := fake(a)
+	f.info.Navigation = info.Navigation
+	f.caps["browse"], f.caps["shows"], f.caps["stations"] = true, true, true
+	a.library.caps = probeCaps(f)
+	a.mineCollapsed, a.savedCollapsed = true, true
+	tt := ui.NewTester(a.view, 1180, 880)
+	settled(tt)
+	saveFrame(t, dir, "netease-sidebar-preview.png", tt.Image())
+}
