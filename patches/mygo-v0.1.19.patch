diff --git a/internal/music/upload.go b/internal/music/upload.go
new file mode 100644
index 0000000..49abfc8
--- /dev/null
+++ b/internal/music/upload.go
@@ -0,0 +1,219 @@
+package music
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"mygo-music/internal/i18n"
+	"os"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"golang.org/x/text/encoding/simplifiedchinese"
+	"golang.org/x/text/encoding/unicode"
+)
+
+var UploadExtensions = []string{"mp3", "aac", "wma", "wav", "ogg", "m4a", "ape", "flac", "cue"}
+
+func IsUploadAudio(path string) bool {
+	ext := strings.TrimPrefix(strings.ToLower(filepath.Ext(path)), ".")
+	return ext != "cue" && slices.Contains(UploadExtensions, ext)
+}
+
+// A cue interval is in CD frames (75 per second); Until -1 means the file's end.
+type UploadSelection struct {
+	Path, Name, Title, Artist, Album string
+	From, Until                      int64
+	Number                           int
+	Cue                              bool
+}
+
+func ResolveUploadFiles(paths []string) ([]UploadSelection, error) {
+	var out []UploadSelection
+	seen := map[string]bool{}
+	for _, path := range paths {
+		resolved, err := filepath.EvalSymlinks(path)
+		if err != nil {
+			return nil, err
+		}
+		var entries []UploadSelection
+		if strings.EqualFold(filepath.Ext(path), ".cue") {
+			entries, err = readCue(resolved)
+			if err != nil {
+				return nil, err
+			}
+		} else {
+			if !IsUploadAudio(path) {
+				return nil, fmt.Errorf(i18n.T("Unsupported audio file: %s"), filepath.Base(path))
+			}
+			entries = []UploadSelection{{Path: resolved, Name: filepath.Base(path), Until: -1}}
+		}
+		for _, entry := range entries {
+			key := fmt.Sprintf("%s:%t:%d:%d", entry.Path, entry.Cue, entry.From, entry.Until)
+			if !seen[key] {
+				seen[key] = true
+				out = append(out, entry)
+			}
+		}
+	}
+	return out, nil
+}
+
+var cueField = regexp.MustCompile(`(?i)^(FILE|TRACK|TITLE|PERFORMER|INDEX)\s+(.*)$`)
+var cueFilename = regexp.MustCompile(`^(?:"([^"]+)"|(\S+))\s+\S+\s*$`)
+var unsafeFilename = regexp.MustCompile(`[<>:"/\\|?*\x00-\x1f]`)
+
+func readCue(path string) ([]UploadSelection, error) {
+	stat, err := os.Stat(path)
+	if err != nil {
+		return nil, err
+	}
+	if !stat.Mode().IsRegular() || stat.Size() > 1<<20 {
+		return nil, errors.New(i18n.T("Invalid or oversized CUE sheet"))
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	switch {
+	case bytes.HasPrefix(data, []byte{0xff, 0xfe}):
+		data, err = unicode.UTF16(unicode.LittleEndian, unicode.ExpectBOM).NewDecoder().Bytes(data)
+	case bytes.HasPrefix(data, []byte{0xfe, 0xff}):
+		data, err = unicode.UTF16(unicode.BigEndian, unicode.ExpectBOM).NewDecoder().Bytes(data)
+	case !utf8.Valid(data):
+		data, err = simplifiedchinese.GB18030.NewDecoder().Bytes(data)
+	}
+	if err != nil {
+		return nil, err
+	}
+	var entries []UploadSelection
+	var audio, album, artist string
+	current := -1
+	for _, line := range strings.Split(strings.TrimPrefix(string(data), "\ufeff"), "\n") {
+		fields := cueField.FindStringSubmatch(strings.TrimSpace(line))
+		if fields == nil {
+			continue
+		}
+		value := strings.TrimSpace(fields[2])
+		switch strings.ToUpper(fields[1]) {
+		case "FILE":
+			parts := cueFilename.FindStringSubmatch(value)
+			if parts == nil {
+				return nil, errors.New(i18n.T("Invalid CUE FILE entry"))
+			}
+			name := parts[1]
+			if name == "" {
+				name = parts[2]
+			}
+			name = strings.ReplaceAll(name, `\`, "/")
+			if !filepath.IsLocal(name) || strings.Contains(name, ":") {
+				return nil, errors.New(i18n.T("CUE references must stay within its folder"))
+			}
+			audio, err = filepath.EvalSymlinks(filepath.Join(filepath.Dir(path), filepath.FromSlash(name)))
+			if err != nil {
+				return nil, err
+			}
+			relative, err := filepath.Rel(filepath.Dir(path), audio)
+			if err != nil || !filepath.IsLocal(relative) {
+				return nil, errors.New(i18n.T("CUE references must stay within its folder"))
+			}
+			if !IsUploadAudio(audio) {
+				return nil, errors.New(i18n.T("CUE references an unsupported audio file"))
+			}
+			current = -1
+		case "TRACK":
+			parts := strings.Fields(value)
+			if len(parts) != 2 || !strings.EqualFold(parts[1], "AUDIO") || audio == "" {
+				return nil, errors.New(i18n.T("CUE requires AUDIO tracks and a FILE entry"))
+			}
+			number, err := strconv.Atoi(parts[0])
+			if err != nil || number <= 0 {
+				return nil, errors.New(i18n.T("Invalid CUE track number"))
+			}
+			entries = append(entries, UploadSelection{Path: audio, Number: number, From: -1, Until: -1, Cue: true, Album: album, Artist: artist})
+			current = len(entries) - 1
+		case "TITLE":
+			value = strings.Trim(value, `"`)
+			if current < 0 {
+				album = value
+			} else {
+				entries[current].Title = value
+			}
+		case "PERFORMER":
+			value = strings.Trim(value, `"`)
+			if current < 0 {
+				artist = value
+			} else {
+				entries[current].Artist = value
+			}
+		case "INDEX":
+			parts := strings.Fields(value)
+			if len(parts) != 2 || parts[0] != "01" {
+				continue
+			}
+			if current < 0 {
+				return nil, errors.New(i18n.T("CUE INDEX has no track"))
+			}
+			timeParts := strings.Split(parts[1], ":")
+			if len(timeParts) != 3 {
+				return nil, errors.New(i18n.T("Invalid CUE track time"))
+			}
+			minute, e1 := strconv.ParseInt(timeParts[0], 10, 64)
+			second, e2 := strconv.ParseInt(timeParts[1], 10, 64)
+			frame, e3 := strconv.ParseInt(timeParts[2], 10, 64)
+			if e1 != nil || e2 != nil || e3 != nil || minute < 0 || minute > 100000 || second < 0 || second > 59 || frame < 0 || frame > 74 {
+				return nil, errors.New(i18n.T("Invalid CUE track time"))
+			}
+			entries[current].From = (minute*60+second)*75 + frame
+		}
+	}
+	if len(entries) == 0 {
+		return nil, errors.New(i18n.T("CUE sheet has no audio tracks"))
+	}
+	for i := range entries {
+		entry := &entries[i]
+		if entry.From < 0 {
+			return nil, errors.New(i18n.T("CUE track is missing INDEX 01"))
+		}
+		if i+1 < len(entries) && entries[i+1].Path == entry.Path {
+			entry.Until = entries[i+1].From
+			if entry.Until <= entry.From {
+				return nil, errors.New(i18n.T("CUE track times must increase"))
+			}
+		}
+		if entry.Title == "" {
+			entry.Title = fmt.Sprintf("Track %02d", entry.Number)
+		}
+		title := []rune(unsafeFilename.ReplaceAllString(entry.Title, "_"))
+		if len(title) > 100 {
+			title = title[:100]
+		}
+		entry.Name = fmt.Sprintf("%02d %s.flac", entry.Number, string(title))
+	}
+	return entries, nil
+}
+
+// PrepareUploadFile losslessly cuts a CUE track and tags it; callers remove it after that upload.
+func PrepareUploadFile(ctx context.Context, entry UploadSelection) (string, func(), error) {
+	noop := func() {}
+	if !entry.Cue {
+		return entry.Path, noop, nil
+	}
+	dir, err := os.MkdirTemp("", "mygo-cue-")
+	if err != nil {
+		return "", noop, err
+	}
+	cleanup := func() { os.RemoveAll(dir) }
+	output := filepath.Join(dir, entry.Name)
+	err = ConvertToFLAC(ctx, entry.Path, output, entry.From, entry.Until, map[string]string{"title": entry.Title, "artist": entry.Artist, "album": entry.Album, "track": strconv.Itoa(entry.Number)})
+	if err != nil {
+		cleanup()
+		return "", noop, err
+	}
+	return output, cleanup, nil
+}
