+package player
+
+import (
+	"context"
+	"os"
+	"testing"
+)
+
+// M4A cloud bytes use compatible decoding, while shared readers leave the original alive.
+func TestCompatibleCloudAudio(t *testing.T) {
+	real := convertAudio
+	defer func() { convertAudio = real }()
+	fixture, err := os.ReadFile("testdata/seek.flac")
+	if err != nil {
+		t.Fatal(err)
+	}
+	convertAudio = func(_ context.Context, input, output string) error {
+		data, err := os.ReadFile(input)
+		if err != nil {
+			return err
+		}
+		if string(data[4:8]) != "ftyp" {
+			t.Fatal("wrong source bytes")
+		}
+		return os.WriteFile(output, fixture, 0600)
+	}
+	dl := downloaded([]byte("\x00\x00\x00\x1cftypM4A \x00\x00\x00\x00"))
+	s, err := openStream(dl, 3000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	shared, err := openShared(dl, 3000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := shared.Read(make([]float32, 64)); err != nil {
+		t.Fatal(err)
+	}
+	shared.Close()
+	if dl.closed {
+		t.Fatal("closing the shared reader closed the original")
+	}
+	dir := s.(*compatibleStream).dir
+	s.Close()
+	if !dl.closed {
+		t.Fatal("source was not released")
+	}
+	if _, err := os.Stat(dir); !os.IsNotExist(err) {
+		t.Fatal("temporary decoded audio was left behind")
+	}
+}
