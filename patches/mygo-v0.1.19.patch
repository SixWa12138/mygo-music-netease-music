+package music
+
+import (
+	"golang.org/x/text/encoding/simplifiedchinese"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// CUE tracks retain metadata and precise boundaries without uploading the index or unrelated files.
+func TestCueUploadSelection(t *testing.T) {
+	dir := t.TempDir()
+	audio := filepath.Join(dir, "整轨.flac")
+	cue := filepath.Join(dir, "整轨.flac.cue")
+	os.WriteFile(audio, []byte("audio"), 0600)
+	content := `PERFORMER "Artist"
+TITLE "Album"
+FILE "整轨.flac" WAVE
+ TRACK 01 AUDIO
+ TITLE "第一首"
+ INDEX 01 00:00:00
+ TRACK 02 AUDIO
+ TITLE "第二首"
+ PERFORMER "Guest"
+ INDEX 01 01:02:37
+`
+	for _, gbk := range []bool{false, true} {
+		data := []byte(content)
+		if gbk {
+			data, _ = simplifiedchinese.GB18030.NewEncoder().Bytes(data)
+		}
+		os.WriteFile(cue, data, 0600)
+		files, err := ResolveUploadFiles([]string{cue, cue})
+		if err != nil || len(files) != 2 {
+			t.Fatalf("got %v, %v", files, err)
+		}
+		if files[0].Path != audio || files[0].Title != "第一首" || files[0].Album != "Album" || files[0].Until != 4687 || files[1].From != 4687 || files[1].Until != -1 || files[1].Artist != "Guest" {
+			t.Fatalf("wrong cue tracks: %+v", files)
+		}
+	}
+	for _, reference := range []string{"../outside.mp3", "C:\\secret.mp3", "missing.mp3", "notes.txt"} {
+		os.WriteFile(cue, []byte("FILE \""+reference+"\" WAVE\n TRACK 01 AUDIO\n INDEX 01 00:00:00\n"), 0600)
+		if _, err := ResolveUploadFiles([]string{cue}); err == nil {
+			t.Fatalf("accepted %q", reference)
+		}
+	}
+	for _, index := range []string{"", "INDEX 01 00:61:00", "INDEX 01 00:00:75"} {
+		os.WriteFile(cue, []byte("FILE \"整轨.flac\" WAVE\n TRACK 01 AUDIO\n"+index+"\n"), 0600)
+		if _, err := ResolveUploadFiles([]string{cue}); err == nil {
+			t.Fatalf("accepted invalid index %q", index)
+		}
+	}
+}
+
+// Every supported audio extension is accepted case-insensitively; an index is not audio.
+func TestUploadAudioFormats(t *testing.T) {
+	for _, name := range []string{"a.MP3", "a.aac", "a.wma", "a.wav", "a.ogg", "a.m4a", "a.ape", "a.FLAC"} {
+		if !IsUploadAudio(name) {
+			t.Fatal(name)
+		}
+	}
+	for _, name := range []string{"a.cue", "a.flac.cue", "a.txt", "a.exe"} {
+		if IsUploadAudio(name) {
+			t.Fatal(name)
+		}
+	}
+}
