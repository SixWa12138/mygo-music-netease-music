diff --git a/internal/plugin/upload.go b/internal/plugin/upload.go
new file mode 100644
index 0000000..89d4b83
--- /dev/null
+++ b/internal/plugin/upload.go
@@ -0,0 +1,183 @@
+package plugin
+
+import (
+	"context"
+	"crypto/md5"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"mygo-music/internal/i18n"
+	"net/http"
+	"os"
+	"time"
+
+	"github.com/MoeForge/moejs"
+	"github.com/dhowden/tag"
+	"mygo-music/internal/music"
+)
+
+type selectedUpload struct {
+	id       string
+	file     *os.File
+	size     int64
+	ctx      context.Context
+	cancel   context.CancelFunc
+	progress func(int64, int64)
+}
+
+// Upload exposes a short-lived handle for the chosen file, never arbitrary filesystem access.
+func (p *Plugin) Upload(ctx context.Context, path string, progress func(int64, int64)) error {
+	if !music.IsUploadAudio(path) {
+		return errors.New(i18n.T("Choose a supported audio file"))
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	stat, err := f.Stat()
+	if err != nil {
+		return err
+	}
+	if !stat.Mode().IsRegular() || stat.Size() == 0 {
+		return errors.New(i18n.T("Choose a valid audio file"))
+	}
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Minute)
+	defer cancel()
+	u := &selectedUpload{id: rand.Text(), file: f, size: stat.Size(), ctx: ctx, cancel: cancel, progress: progress}
+	p.mu.Lock()
+	if p.upload != nil {
+		p.mu.Unlock()
+		return errors.New(i18n.T("A file is already uploading"))
+	}
+	p.upload = u
+	p.mu.Unlock()
+	defer func() { p.mu.Lock(); p.upload = nil; p.mu.Unlock() }()
+	hash := md5.New()
+	if _, err := io.Copy(hash, &uploadReader{Reader: f, ctx: ctx}); err != nil {
+		return err
+	}
+	info := map[string]any{"id": u.id, "name": stat.Name(), "size": u.size, "md5": hex.EncodeToString(hash.Sum(nil))}
+	if _, err := f.Seek(0, io.SeekStart); err != nil {
+		return err
+	}
+	if tags, err := tag.ReadFrom(f); err == nil {
+		info["title"], info["artist"], info["album"] = tags.Title(), tags.Artist(), tags.Album()
+	}
+	if progress != nil {
+		progress(0, u.size)
+	}
+	return p.callContext(ctx, 30*time.Minute, "upload", map[string]any{"file": info}, nil)
+}
+
+func (p *Plugin) selectedFile(id string) (*selectedUpload, error) {
+	p.mu.Lock()
+	u := p.upload
+	p.mu.Unlock()
+	if u == nil || u.id != id {
+		return nil, errors.New(i18n.T("This file was not selected for upload"))
+	}
+	if err := u.ctx.Err(); err != nil {
+		return nil, err
+	}
+	return u, nil
+}
+
+func (p *Plugin) uploadCheckpoint(_ *moejs.Realm, _ moejs.Value, args []moejs.Value) (moejs.Value, error) {
+	_, err := p.selectedFile(moejs.Arg(args, 0).String())
+	return moejs.Undefined(), err
+}
+
+func (p *Plugin) uploadFile(v *vm) native {
+	return func(_ *moejs.Realm, _ moejs.Value, args []moejs.Value) (moejs.Value, error) {
+		var opts struct {
+			ID      string            `json:"id"`
+			URL     string            `json:"url"`
+			Headers map[string]string `json:"headers"`
+		}
+		if err := v.rt.ToGoInto(moejs.Arg(args, 0), &opts); err != nil {
+			return moejs.Undefined(), err
+		}
+		u, err := p.selectedFile(opts.ID)
+		if err != nil {
+			return moejs.Undefined(), err
+		}
+		body := &uploadReader{Reader: io.NewSectionReader(u.file, 0, u.size), ctx: u.ctx, total: u.size, progress: u.progress}
+		req, err := http.NewRequestWithContext(u.ctx, http.MethodPost, opts.URL, body)
+		if err != nil {
+			return moejs.Undefined(), err
+		}
+		req.ContentLength = u.size
+		for name, value := range opts.Headers {
+			req.Header.Set(name, value)
+		}
+		p.mu.Lock()
+		web := p.webOptions()
+		p.mu.Unlock()
+		if web.Client == nil {
+			return moejs.Undefined(), errors.New(i18n.T("Uploads require network permission"))
+		}
+		if web.Allow != nil {
+			if err := web.Allow(req); err != nil {
+				return moejs.Undefined(), err
+			}
+		}
+		client := *web.Client
+		client.CheckRedirect = func(*http.Request, []*http.Request) error {
+			return errors.New(i18n.T("Upload redirects are not allowed"))
+		}
+		promise, settle := v.loop.NewPromise()
+		go func() {
+			data, err := sendUpload(&client, req)
+			settle(func(rt *moejs.Runtime) (moejs.Value, error) {
+				if err != nil {
+					return moejs.Undefined(), err
+				}
+				return rt.ParseJSON(data)
+			})
+		}()
+		return promise, nil
+	}
+}
+
+func sendUpload(client *http.Client, req *http.Request) ([]byte, error) {
+	res, err := client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer res.Body.Close()
+	if res.StatusCode < 200 || res.StatusCode >= 300 {
+		return nil, fmt.Errorf(i18n.T("Audio upload failed (HTTP %d)"), res.StatusCode)
+	}
+	data, err := io.ReadAll(io.LimitReader(res.Body, 1<<20))
+	if err != nil {
+		return nil, err
+	}
+	if !json.Valid(data) {
+		return nil, errors.New(i18n.T("The upload server returned an invalid result"))
+	}
+	return data, nil
+}
+
+type uploadReader struct {
+	io.Reader
+	ctx               context.Context
+	sent, total, last int64
+	progress          func(int64, int64)
+}
+
+func (r *uploadReader) Read(b []byte) (int, error) {
+	if err := r.ctx.Err(); err != nil {
+		return 0, err
+	}
+	n, err := r.Reader.Read(b)
+	r.sent += int64(n)
+	if r.progress != nil && (r.sent-r.last >= 256<<10 || r.sent == r.total) {
+		r.last = r.sent
+		r.progress(r.sent, r.total)
+	}
+	return n, err
+}
