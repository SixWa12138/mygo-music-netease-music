+++ b/internal/music/convert.go
@@ -0,0 +1,44 @@
+package music
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"maps"
+	"mygo-music/internal/i18n"
+	"os/exec"
+	"runtime"
+	"slices"
+)
+
+func ConvertToFLAC(ctx context.Context, input, output string, from, until int64, tags map[string]string) error {
+	name := "ffmpeg"
+	if runtime.GOOS == "windows" {
+		name += ".exe"
+	}
+	command, err := exec.LookPath(name)
+	if err != nil {
+		return errors.New(i18n.T("This audio format requires FFmpeg on PATH"))
+	}
+	args := []string{"-nostdin", "-v", "error", "-y", "-protocol_whitelist", "file,pipe"}
+	if from > 0 {
+		args = append(args, "-ss", fmt.Sprintf("%.6f", float64(from)/75))
+	}
+	args = append(args, "-i", input, "-map", "0:a:0", "-vn", "-ac", "2", "-c:a", "flac")
+	if until >= 0 {
+		args = append(args, "-t", fmt.Sprintf("%.6f", float64(until-from)/75))
+	}
+	for _, key := range slices.Sorted(maps.Keys(tags)) {
+		args = append(args, "-metadata", key+"="+tags[key])
+	}
+	args = append(args, output)
+	cmd := exec.CommandContext(ctx, command, args...)
+	hideAudioCommand(cmd)
+	if err := cmd.Run(); err != nil {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		return fmt.Errorf(i18n.T("Audio conversion failed: %w"), err)
+	}
+	return nil
+}
