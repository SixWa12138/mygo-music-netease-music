new file mode 100644
index 0000000..873e782
--- /dev/null
+++ b/internal/app/upload_test.go
@@ -0,0 +1,125 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/egoist/mygo/ui"
+	"mygo-music/internal/music"
+)
+
+// A browse tab opens its own data while keeping the source and queue.
+func TestBrowseTabNavigation(t *testing.T) {
+	a := newTestApp()
+	ch := posts(a)
+	f := fake(a)
+	tabs := []music.BrowseTab{{Title: "Subscribed", Page: "mine", Selected: true}, {Title: "Created", Page: "created"}}
+	a.browses["mine"] = &browseData{page: &music.Browse{Title: "Podcasts", Tabs: tabs}}
+	f.browse = func(page string) (*music.Browse, error) { return &music.Browse{Title: page}, nil }
+	a.route = route{page: pageBrowse, src: a.id, id: "mine"}
+	tt := ui.NewTester(a.view, 1200, 800)
+	tt.Frame()
+	if err := tt.Click("Created"); err != nil {
+		t.Fatal(err)
+	}
+	if a.route.id != "created" || a.route.src != a.id {
+		t.Fatalf("wrong route: %+v", a.route)
+	}
+	runPost(t, ch)
+	if a.browses["created"].page.Title != "created" {
+		t.Fatal("tab data did not load")
+	}
+}
+
+// Canceling the picker transfers nothing; a batch reports failures separately and refreshes the cloud page.
+func TestUploadPickerAndBatch(t *testing.T) {
+	a := newTestApp()
+	ch := posts(a)
+	f := fake(a)
+	real := pickUploadFiles
+	defer func() { pickUploadFiles = real }()
+	var picked func([]string, error)
+	pickers := 0
+	pickUploadFiles = func(_ *app, got func([]string, error)) { pickers++; picked = got }
+	a.browses["cloud"] = &browseData{page: &music.Browse{Title: "Cloud", Upload: true}}
+	a.route = route{page: pageBrowse, src: a.id, id: "cloud"}
+	tt := ui.NewTester(a.view, 1200, 800)
+	tt.Frame()
+	if err := tt.Click(T("Upload Music")); err != nil {
+		t.Fatal(err)
+	}
+	tt.Frame()
+	// The upload control stays in place while choosing, without opening another picker.
+	if err := tt.Click(T("Upload Music")); err != nil {
+		t.Fatal(err)
+	}
+	if pickers != 1 {
+		t.Fatalf("opened %d pickers", pickers)
+	}
+	picked(nil, nil)
+	if a.upload != nil {
+		t.Fatal("cancelled picker created an upload")
+	}
+	paths := uploadFixtureFiles(t, "first.mp3", "second.flac")
+	pickUploadFiles = func(_ *app, got func([]string, error)) { got(paths, nil) }
+	var uploaded []string
+	f.uploadFile = func(ctx context.Context, path string, progress func(int64, int64)) error {
+		uploaded = append(uploaded, path)
+		progress(10, 10)
+		if path == paths[1] {
+			return errors.New("offline")
+		}
+		return nil
+	}
+	f.browse = func(page string) (*music.Browse, error) { return &music.Browse{Title: "refreshed", Upload: true}, nil }
+	a.chooseUpload(a.library, "cloud")
+	until(t, ch, func() bool { return !a.upload.busy })
+	until(t, ch, func() bool { return a.browses["cloud"] != nil && a.browses["cloud"].page != nil })
+	if !reflect.DeepEqual(uploaded, paths) || a.upload.succeeded != 1 || len(a.upload.errors) != 1 {
+		t.Fatalf("wrong batch result: %+v", a.upload)
+	}
+}
+
+// Cancel stops the active upload and leaves later selected files untouched.
+func TestCancelUploadBatch(t *testing.T) {
+	a := newTestApp()
+	ch := posts(a)
+	f := fake(a)
+	real := pickUploadFiles
+	defer func() { pickUploadFiles = real }()
+	paths := uploadFixtureFiles(t, "first.mp3", "second.mp3")
+	pickUploadFiles = func(_ *app, got func([]string, error)) { got(paths, nil) }
+	started := make(chan struct{})
+	calls := 0
+	f.uploadFile = func(ctx context.Context, _ string, _ func(int64, int64)) error {
+		calls++
+		close(started)
+		<-ctx.Done()
+		return ctx.Err()
+	}
+	f.browse = func(string) (*music.Browse, error) { return &music.Browse{Upload: true}, nil }
+	a.chooseUpload(a.library, "cloud")
+	<-started
+	a.upload.cancel()
+	until(t, ch, func() bool { return !a.upload.busy })
+	if calls != 1 || a.upload.succeeded != 0 {
+		t.Fatal("cancelled batch continued")
+	}
+}
+
+func uploadFixtureFiles(t *testing.T, names ...string) []string {
+	t.Helper()
+	dir := t.TempDir()
+	paths := make([]string, len(names))
+	for i, name := range names {
+		paths[i] = filepath.Join(dir, name)
+		if err := os.WriteFile(paths[i], []byte("fixture"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return paths
+}
