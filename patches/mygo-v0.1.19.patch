@@ -0,0 +1,92 @@
+package player
+
+import (
+	"context"
+	"errors"
+	"io"
+	"math"
+	"mygo-music/internal/music"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+)
+
+// Compatibility formats use the installed FFmpeg; the original cloud file stays unchanged.
+// shortcut: these formats wait for the whole download; use a streaming decoder if startup delay becomes a problem.
+var convertAudio = func(ctx context.Context, input, output string) error {
+	return music.ConvertToFLAC(ctx, input, output, 0, -1, nil)
+}
+
+type compatibleStream struct {
+	*flacStream
+	original *download
+	dir      string
+	release  func()
+	once     sync.Once
+}
+
+func openCompatibleStream(dl *download) (*compatibleStream, error) {
+	dl.waitFor(math.MaxInt64)
+	dl.mu.Lock()
+	err, closed := dl.err, dl.closed
+	dl.mu.Unlock()
+	if err != nil {
+		return nil, err
+	}
+	if closed {
+		return nil, errors.New("audio download closed")
+	}
+	dir, err := os.MkdirTemp("", "mygo-audio-")
+	if err != nil {
+		return nil, err
+	}
+	ok := false
+	defer func() {
+		if !ok {
+			os.RemoveAll(dir)
+		}
+	}()
+	input := filepath.Join(dir, "source.audio")
+	f, err := os.Create(input)
+	if err != nil {
+		return nil, err
+	}
+	_, err = io.Copy(f, &downloadReader{d: dl})
+	closeErr := f.Close()
+	if err != nil {
+		return nil, err
+	}
+	if closeErr != nil {
+		return nil, closeErr
+	}
+	output := filepath.Join(dir, "decoded.flac")
+	ctx, cancel := context.WithTimeout(dl.ctx, 5*time.Minute)
+	defer cancel()
+	if err := convertAudio(ctx, input, output); err != nil {
+		return nil, err
+	}
+	f, err = os.Open(output)
+	if err != nil {
+		return nil, err
+	}
+	stat, err := f.Stat()
+	if err != nil {
+		f.Close()
+		return nil, err
+	}
+	converted := opened(f, stat.Size())
+	stream, err := openFLACStream(converted)
+	if err != nil {
+		converted.Close()
+		return nil, err
+	}
+	ok = true
+	return &compatibleStream{flacStream: stream, original: dl, dir: dir, release: dl.Close}, nil
+}
+
+func (s *compatibleStream) source() (*download, *spectrum) { return s.original, s.spec }
+func (s *compatibleStream) Close() error {
+	s.once.Do(func() { s.flacStream.Close(); s.release(); os.RemoveAll(s.dir) })
+	return nil
+}
