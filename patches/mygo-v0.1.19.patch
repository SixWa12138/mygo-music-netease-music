+			t.Error("wrong length or unintended cookies")
+		}
+		fmt.Fprintf(w, `{"offset":%d}`, len(got))
+	}))
+	defer server.Close()
+	p := load(t, `{"id":"x","permissions":{"network":["127.0.0.1"]}}`, fmt.Sprintf(`
+let saved;
