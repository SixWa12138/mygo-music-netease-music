diff --git a/internal/app/ui_upload.go b/internal/app/ui_upload.go
new file mode 100644
index 0000000..aa64d20
--- /dev/null
+++ b/internal/app/ui_upload.go
@@ -0,0 +1,138 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/egoist/mygo"
+	"github.com/egoist/mygo/ui"
+	"mygo-music/internal/music"
+)
+
+type uploadState struct {
+	busy                 bool
+	name                 string
+	at, total, succeeded int
+	sent, size           int64
+	errors               []string
+	cancel               context.CancelFunc
+	cancelled            bool
+}
+
+var pickUploadFiles = func(a *app, got func([]string, error)) {
+	go func() {
+		paths, err := mygo.Dialog.Open(mygo.OpenDialogOptions{Parent: a.win, Title: T("Upload Music"), ButtonLabel: T("Upload"), Multiple: true,
+			Filters: []mygo.FileFilter{{Name: T("Music files"), Extensions: music.UploadExtensions}}})
+		a.post(func() { got(paths, err) })
+	}()
+}
+
+func (a *app) chooseUpload(lib *library, page string) {
+	if lib.upload != nil && lib.upload.busy {
+		return
+	}
+	uploader, ok := lib.src.(music.Uploader)
+	if !ok || !lib.can("upload") {
+		return
+	}
+	state := &uploadState{busy: true}
+	lib.upload = state
+	pickUploadFiles(a, func(paths []string, err error) {
+		if err != nil {
+			state.busy = false
+			state.errors = []string{err.Error()}
+			return
+		}
+		if len(paths) == 0 {
+			lib.upload = nil
+			return
+		}
+		ctx, cancel := context.WithCancel(context.Background())
+		state.cancel, state.total = cancel, len(paths)
+		go func() {
+			defer cancel()
+			files, err := music.ResolveUploadFiles(paths)
+			if err != nil {
+				a.post(func() { state.busy = false; state.errors = []string{err.Error()} })
+				return
+			}
+			a.post(func() { state.total = len(files) })
+			for i, entry := range files {
+				if ctx.Err() != nil {
+					break
+				}
+				name := entry.Name
+				a.post(func() { state.at, state.name, state.sent, state.size = i+1, name, 0, 0 })
+				path, cleanup, err := music.PrepareUploadFile(ctx, entry)
+				if err == nil {
+					err = uploader.Upload(ctx, path, func(sent, total int64) { a.post(func() { state.sent, state.size = sent, total }) })
+				}
+				cleanup()
+				if err != nil {
+					if errors.Is(err, context.Canceled) {
+						break
+					}
+					a.post(func() { state.errors = append(state.errors, fmt.Sprintf("%s: %v", name, err)) })
+				} else {
+					a.post(func() { state.succeeded++ })
+				}
+			}
+			a.post(func() {
+				state.busy = false
+				// Refresh even after cancellation: earlier files in a batch may have completed.
+				for _, d := range lib.browses {
+					if d.page != nil && d.page.Upload {
+						d.page = nil
+					}
+				}
+				a.loadBrowse(lib, page, true)
+			})
+		}()
+	})
+}
+
+func (a *app) uploadControls(c *ui.Context, lib *library, page string) {
+	if !lib.can("upload") {
+		return
+	}
+	s := lib.upload
+	ui.Column(c).Gap(8).Margin(0, 0, 18, 0).Children(func() {
+		if s == nil || !s.busy || s.total == 0 {
+			ui.Row(c).Children(func() {
+				if pillButton(c.Key("upload"), iconPlus, T("Upload Music"), a.pal.accent, a.pal.onAccent).Clicked() {
+					a.chooseUpload(lib, page)
+				}
+			})
+		} else {
+			ui.Row(c).Gap(12).AlignItems(ui.Center).Children(func() {
+				label := Tf("Uploading %d/%d · %s", s.at, s.total, s.name)
+				ui.Text(c, label).FontSize(13).SingleLine().Shrink(1)
+				if s.cancel != nil && ui.Button(c.Key("cancel-upload"), T("Cancel Upload")).Clicked() {
+					s.cancelled = true
+					s.cancel()
+				}
+			})
+			if s.size > 0 {
+				percent := min(100, int(s.sent*100/s.size))
+				label := fmt.Sprintf("%d%%", percent)
+				if percent == 100 {
+					label = T("Saving to your cloud…")
+				}
+				ui.Text(c, label).FontSize(12).TextColor(a.pal.muted)
+			}
+		}
+		if s != nil && !s.busy {
+			label := Tf("Uploaded %d files", s.succeeded)
+			if s.cancelled {
+				label = Tf("Upload cancelled · %d files uploaded", s.succeeded)
+			}
+			ui.Text(c, label).FontSize(13).TextColor(a.pal.muted)
+		}
+		if s != nil {
+			for _, message := range s.errors {
+				ui.Text(c, message).FontSize(12).TextColor(a.pal.muted)
+			}
+		}
+	})
+}
