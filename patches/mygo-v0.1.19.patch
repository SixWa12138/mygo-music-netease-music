+// NOS redirects cannot forward a selected file or token to another destination.
+func TestUploadRejectsRedirect(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Redirect(w, r, "https://not-allowed.invalid", http.StatusTemporaryRedirect)
+	}))
+	defer server.Close()
+	p := load(t, `{"id":"x","permissions":{"network":["127.0.0.1"]}}`, fmt.Sprintf(`export function upload({file}){return host.uploadFile({id:file.id,url:%q});}`, server.URL))
+	path := filepath.Join(t.TempDir(), "sample.flac")
+	os.WriteFile(path, []byte("sample"), 0600)
+	if err := p.Upload(context.Background(), path, nil); err == nil {
+		t.Fatalf("got %v", err)
+	}
