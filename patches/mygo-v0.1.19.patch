+// A plugin cannot choose an arbitrary file or upload a selected one to an undeclared host.
+func TestUploadNeedsSelectionAndNetwork(t *testing.T) {
+	p := load(t, `{"id":"x","permissions":{"network":["allowed.invalid"]}}`, `
+export function withoutSelection(){return host.uploadFile({id:"invented",url:"https://allowed.invalid"});}
+export function upload({file}){return host.uploadFile({id:file.id,url:"https://not-allowed.invalid"});}
+`)
+	if err := p.call("withoutSelection", nil, nil); err == nil {
+		t.Fatal("unselected file accepted")
+	}
+	path := filepath.Join(t.TempDir(), "sample.mp3")
+	os.WriteFile(path, []byte("sample"), 0600)
+	if err := p.Upload(context.Background(), path, nil); err == nil {
+		t.Fatal("undeclared destination accepted")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := p.Upload(ctx, path, nil); err == nil {
+		t.Fatal("cancelled upload started")
+	}
+}
